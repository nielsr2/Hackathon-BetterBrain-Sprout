<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline harness: compiles the Unity-free Core + its NUnit tests outside Unity and runs
       them by reflection (Runner.cs). Lives under Tests~ so Unity never imports it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <UnityData Condition="'$(UnityData)' == ''">C:\Program Files\Unity\Hub\Editor\6000.5.6f1\Editor\Data</UnityData>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\Core\**\*.cs" />
    <Compile Include="..\..\Tests\Editor\Core\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="nunit.framework">
      <HintPath>$(UnityData)\Resources\PackageManager\BuiltInPackages\com.unity.ext.nunit\net472\unity-custom\nunit.framework.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
