# Unity: only Assets/, Packages/, ProjectSettings/ need tracking;
# everything else is regenerated by the editor.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
Assets/_Recovery/
Assets/_Recovery.meta

# Never ignore an Assets folder that happens to match a pattern above
!/[Aa]ssets/**

# IDE caches / generated project files
.vs/
.idea/
.vscode/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports / autogenerated
sysinfo.txt
crashlytics-build.properties

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
.venv/

# Claude session memory
.remember/

# Editor screenshots taken during MCP sessions
Captures/
